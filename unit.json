{
    "listeners": {
        "*:8000": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "match": {
                "uri": "!/index.php"
            },
            "action": {
                "share": "/var/www/html/public$uri",
                "fallback": {
                    "pass": "applications/laravel"
                }
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "root": "/var/www/html/public/",
            "script": "index.php",
            "user": "unit",
            "group": "unit"
        }
    },
    "settings": {
        "http": {
            "log_stream": "stderr" 
        },
        "php": {
            "log_errors": true,
            "error_log": "stderr" 
        }
    }
}
